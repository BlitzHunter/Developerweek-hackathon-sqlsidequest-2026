# Miro App ID (required) — get from https://miro.com/app/settings/user-profile/apps
VITE_MIRO_APP_ID=your_miro_app_id_here

# LLM API key (required for mystery generation & hints)
GEMINI_API_KEY=
# Optional Gemini model overrides:
# GEMINI_GENERATE_MODEL=gemini-2.5-pro
# GEMINI_HINT_MODEL=gemini-2.5-flash
# If you see occasional 503/high-demand errors, try:
# GEMINI_GENERATE_MODEL=gemini-2.0-flash
# GEMINI_HINT_MODEL=gemini-2.0-flash

# Optional: Rain background GIF (upload public/gif/rain_bg.gif to imgur.com and paste URL here)
VITE_RAIN_BG_URL=

# Optional: Cork board image (upload public/image/1-cork-board.jpg to imgur.com and paste URL here)
VITE_CORK_IMAGE_URL=

# Optional: restrict CORS to a specific origin (defaults to *)
# ALLOWED_ORIGIN=https://your-app.vercel.app

# Optional: ElevenLabs API key for text-to-speech (get from https://elevenlabs.io)
ELEVENLABS_API_KEY=
